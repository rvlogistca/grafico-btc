# Código original adaptado para incluir Bitcoin

import requests
import json

def get_bitcoin_price():
    url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,brl"
    response = requests.get(url)
    data = response.json()
    
    btc_usd = data['bitcoin']['usd']
    btc_brl = data['bitcoin']['brl']
    
    print(f"Preço do Bitcoin (USD): ${btc_usd:,.2f}")
    print(f"Preço do Bitcoin (BRL): R${btc_brl:,.2f}")
    
    return {
        "usd": btc_usd,
        "brl": btc_brl
    }

def calcular_valor_em_btc(valor_brl):
    precos = get_bitcoin_price()
    quantidade_btc = valor_brl / precos['brl']
    print(f"\nR${valor_brl:,.2f} equivale a {quantidade_btc:.8f} BTC")
    return quantidade_btc

# Exemplo de uso
if __name__ == "__main__":
    print("=== Cotação Bitcoin ===")
    get_bitcoin_price()
    
    print("\n=== Conversão ===")
    calcular_valor_em_btc(1000)  # Converte R$1000 para BTC
